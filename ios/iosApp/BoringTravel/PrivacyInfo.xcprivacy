<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No tracking. Storage, photos, location and sign-in add their entries as they arrive. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- Round 23: Google sign-in and Drive keep the traveller's name, email and backups between the phone, Google and
	     their own Drive (BoringTravel has no server that keeps them), so they are not collected. Sign in with Apple is
	     different: its account lives in the owner's Firebase Authentication (so Delete account can revoke Apple's
	     token, App Review 5.1.1(v)), which keeps the email Apple shares (or Apple's relay address) and Apple's user id,
	     linked to the person, for the account only, never for tracking. Only builds with apple.signIn on ask Apple. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Round 24, the community (Android's): signing in to it puts the Google or Apple account into the owner's Firebase
		     Authentication (its email, name and user id, above and here), and the community's Firestore keeps what the
		     traveller makes there, shown to other travellers: the profile (username, name, bio, picture), posts and their
		     trip plans, likes, follows, blocks and reports. All linked to the person, for the community only, never for
		     tracking; Delete profile and Delete account delete them. (Round 25's posting adds the posts' photos and clips,
		     which stay in the poster's own Drive, shared by link.) -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- UserDefaults keeps the traveller's own trips and settings, on the phone (it was used from the first round;
		     the reason was missing until 19 Nov 2026). -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!-- Round 19: the trip video's editor reads when its own copied videos and voice lines were written (in the
		     app's container), so files no edit uses any more are deleted after an hour (Android's ClipMedia.sweep).
		     Since the second parity round also a note's video half made 720p by a stopped app (journal-videos/, in the
		     app's container) goes after an hour (Android's JournalVideos.workDir): the same reason. Since round 24 also the
		     community's clips in the app's caches: the newest few are kept (Android's Community.prune), the same reason. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<!-- Round 20: the trip video's export reads how much room the phone has before it starts, and says it can't make
		     the video when there isn't enough (the user sees that), instead of failing a minute in. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
