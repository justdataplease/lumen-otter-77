<?xml version="1.0" encoding="utf-8"?>
<!-- "Quick bar" (4x1, resizable 3x1 to the full row): stamp, today's trip, Note, Camera and, when wide, Voice. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_quick_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/quick_widget_preview"
    android:previewImage="@drawable/quick_widget_preview_image"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:minResizeWidth="200dp"
    android:minResizeHeight="40dp"
    android:resizeMode="horizontal"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="3600000"
    android:widgetCategory="home_screen" />
