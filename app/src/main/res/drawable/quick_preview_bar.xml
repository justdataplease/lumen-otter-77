<?xml version="1.0" encoding="utf-8"?>
<!-- The Quick bar in the widget picker: Notebook paper (dots), flat shadow, hairline edge. The live widget draws its
     own bitmap per look (widget/WidgetArt.kt). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#1A1E2A5A" />
        </shape>
    </item>
    <item android:bottom="3dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/brand_paper" />
        </shape>
    </item>
    <item android:bottom="3dp" android:right="2dp">
        <bitmap android:src="@drawable/paper_dot_tile" android:tileMode="repeat" />
    </item>
    <item android:bottom="3dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#FFD8DCEA" />
        </shape>
    </item>
</layer-list>
