<?xml version="1.0" encoding="utf-8"?>
<!-- The Note pill in the widget picker: the highlighter, leaning like the notebooks' tab pill. -->
<rotate xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromDegrees="-1.5"
    android:toDegrees="-1.5"
    android:pivotX="50%"
    android:pivotY="50%">
    <inset android:insetTop="2.5dp" android:insetBottom="2.5dp" android:insetLeft="1.5dp" android:insetRight="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/brand_highlighter" />
        </shape>
    </inset>
</rotate>
